+mtl_compute_encoder *
+cs_get_compute(struct kk_cmd_buffer *cmd, bool pre_gfx)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_cs *cs = &cmd->cs;
